# 改行コードを揃える(リポジトリ内は LF、Windows のチェックアウトだけ CRLF に変換)
* text=auto

*.ts   text
*.js   text
*.mjs  text
*.json text
*.md   text
*.cjs  text

# Windows 用の実行スクリプトは常に CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# POSIX スクリプトは常に LF
*.sh   text eol=lf

# バイナリは触らない
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.exe  binary
